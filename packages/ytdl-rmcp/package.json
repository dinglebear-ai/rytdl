{
  "name": "@dinglebear/rytdl",
  "version": "1.0.4",
  "description": "MCP server and CLI for yt-dlp: search and download media, embed metadata and cover art, then deliver to local, SSH, or rclone targets and Plex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinglebear-ai/rytdl.git",
    "directory": "packages/ytdl-rmcp"
  },
  "bin": {
    "ytdl-rmcp": "bin/rytdl.js",
    "rytdl": "bin/rytdl.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "README.md",
    "LICENSE*",
    "package.json"
  ],
  "scripts": {
    "prepack": "node scripts/sync-readme.js",
    "postinstall": "node scripts/install.js",
    "test": "node --test",
    "check": "node --check bin/rytdl.js && node --check scripts/install.js && node --check lib/platform.js && node --check scripts/sync-readme.js && node --check scripts/check-package.js && node scripts/check-package.js",
    "prepublishOnly": "node scripts/check-package.js --release"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://rytdl.dinglebear.ai",
  "bugs": {
    "url": "https://github.com/dinglebear-ai/rytdl/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "rmcp",
    "rust",
    "cli",
    "yt-dlp",
    "youtube",
    "media-downloader",
    "ffmpeg",
    "plex",
    "metadata",
    "ssh",
    "rclone",
    "homelab",
    "claude-code",
    "codex",
    "gemini",
    "mcp-apps"
  ],
  "mcpName": "ai.dinglebear/rytdl",
  "binaryVersion": "1.0.4",
  "author": {
    "name": "dinglebear.ai",
    "url": "https://dinglebear.ai"
  },
  "publishConfig": {
    "access": "public"
  }
}
